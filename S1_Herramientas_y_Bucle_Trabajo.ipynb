    "    print(\"Sin clave: §6 no se puede verificar. El resto del notebook sí.\")\n",
    "else:\n",
    "    prueba = agente.invoke(\n",
    "        {\"messages\": [{\"role\": \"user\", \"content\":\n",
    "                       \"¿Cuál fue el revenue de NVIDIA en FY2024?\"}]},\n",
    "        config={\"configurable\": {\"thread_id\": \"verificacion-s1\"}},\n",
    "    )\n",
