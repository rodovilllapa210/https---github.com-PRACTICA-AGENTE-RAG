        "    ensure_ascii=False,\n",
        "    indent=2,\n",
        "))\n",
        "\n",
        "print(\"\\nTRAYECTORIA\")\n",
        "print(json.dumps(\n",
        "    registro_n1_limitado[\"trayectoria\"],\n",
        "    ensure_ascii=False,\n",
        "    indent=2,\n",
        "))\n",
        "\n",
        "print(\"\\nMÉTRICAS\")\n",
