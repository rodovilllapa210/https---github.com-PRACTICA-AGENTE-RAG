        "def uso_tokens(resultado):\n",
        "    \"\"\"Suma el consumo de todas las llamadas al modelo en una ejecución del agente.\"\"\"\n",
        "    totales = {\n",
        "        \"input_tokens\": 0,\n",
        "        \"output_tokens\": 0,\n",
        "        \"total_tokens\": 0,\n",
        "        \"reasoning_tokens\": 0,\n",
        "        \"model_calls\": 0,\n",
        "    }\n",
        "\n",
        "    for mensaje in resultado[\"messages\"]:\n",
        "        usage = getattr(mensaje, \"usage_metadata\", None)\n",
        "        if not usage:\n",
        "            continue\n",
        "\n",
        "        totales[\"model_calls\"] += 1\n",
        "        totales[\"input_tokens\"] += usage.get(\"input_tokens\", 0)\n",
        "        totales[\"output_tokens\"] += usage.get(\"output_tokens\", 0)\n",
        "        totales[\"total_tokens\"] += usage.get(\"total_tokens\", 0)\n",
        "\n",
        "        output_details = usage.get(\"output_token_details\") or {}\n",
        "        totales[\"reasoning_tokens\"] += output_details.get(\"reasoning\", 0)\n",
        "\n",
        "    return totales\n",
        "\n",
        "\n",
        "print(uso_tokens(r_test))"
