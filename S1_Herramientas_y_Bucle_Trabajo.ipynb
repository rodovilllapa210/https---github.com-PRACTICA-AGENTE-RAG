        "    y que no se hayan usado otras herramientas operativas innecesarias.\n",
        "\n",
        "    list_available se considera auxiliar y no penaliza.\n",
        "    \"\"\"\n",
        "    esperadas = set(registro[\"esperado\"][\"herramientas\"])\n",
        "\n",
        "    observadas_lista = [\n",
        "        paso[\"name\"]\n",
        "        for paso in registro.get(\"trayectoria\", [])\n",
        "    ]\n",
        "    observadas = set(observadas_lista)\n",
        "\n",
        "    auxiliares = {\"list_available\"}\n",
        "\n",
        "    faltantes = sorted(esperadas - observadas)\n",
        "    inesperadas = sorted(\n",
        "        observadas - esperadas - auxiliares\n",
        "    )\n",
        "\n",
        "    return {\n",
        "        \"ok\": not faltantes and not inesperadas,\n",
        "        \"esperadas\": sorted(esperadas),\n",
        "        \"observadas\": observadas_lista,\n",
        "        \"faltantes\": faltantes,\n",
        "        \"inesperadas\": inesperadas,\n",
        "    }"
